<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The engine: the sound-table mixer and the music synthesizer with its song formats. It depends on nothing but
    .NET itself; a host plays it through any device by calling AudioMixer.Render from the device's callback, or
    through Encore.Audio.Sdl.
  -->
  <PropertyGroup>
    <PackageId>Encore.Audio</PackageId>
    <Description>A dependency-free .NET audio engine for games: a 48 kHz stereo mixer for a table of positioned sound effects, and a music synthesizer that plays encore.song and Standard MIDI files with arrangeable parts. NativeAOT-compatible; no native libraries.</Description>
    <PackageTags>audio;mixer;synthesizer;music;midi;game-dev;nativeaot</PackageTags>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Encore.Audio.Tests" />
    <None Include="../../README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>
